From: Massimo Mazzariol <massimomazzariol@users.noreply.github.com>
Subject: [PATCH] mac80211: add B43_PHY_AC package option

Expose the b43 B43_PHY_AC option (experimental receive-only BCM4360
support) in the kmod-b43 configuration menu.
---
--- a/package/kernel/mac80211/broadcom.mk
+++ b/package/kernel/mac80211/broadcom.mk
@@ -8,6 +8,7 @@
 	CONFIG_PACKAGE_B43_PHY_N \
 	CONFIG_PACKAGE_B43_PHY_LP \
 	CONFIG_PACKAGE_B43_PHY_HT \
+	CONFIG_PACKAGE_B43_PHY_AC \
 	CONFIG_PACKAGE_B43_BUSES_BCMA_AND_SSB \
 	CONFIG_PACKAGE_B43_BUSES_BCMA \
 	CONFIG_PACKAGE_B43_BUSES_SSB \
@@ -21,6 +22,7 @@
 config-$(CONFIG_PACKAGE_B43_PHY_N) += B43_PHY_N
 config-$(CONFIG_PACKAGE_B43_PHY_LP) += B43_PHY_LP
 config-$(CONFIG_PACKAGE_B43_PHY_HT) += B43_PHY_HT
+config-$(CONFIG_PACKAGE_B43_PHY_AC) += B43_PHY_AC
 config-$(CONFIG_PACKAGE_B43_PIO) += B43_PIO
 config-$(CONFIG_PACKAGE_B43_DEBUG) += B43_DEBUG
 
@@ -322,6 +324,18 @@
 
 		  If unsure, say Y.
 
+	config PACKAGE_B43_PHY_AC
+		bool "Enable experimental AC-PHY support (receive-only BCM4360)"
+		depends on PACKAGE_B43_BUSES_BCMA || PACKAGE_B43_BUSES_BCMA_AND_SSB
+		default n
+		help
+		  Experimental, receive-only support for the BCM4360 2.4 GHz
+		  device (SROM device ID 0x43a1) of the ASUS RT-AC68U: passive
+		  scanning only, with transmission disabled.  Other boards and
+		  AC-PHY devices are rejected.  The device also needs hardware
+		  data packages in /lib/firmware/b43/ that are not part of
+		  OpenWrt.
+
 	config PACKAGE_B43_PHY_LCN
 		bool "Enable support for LCN-PHYs"
 		depends on BROKEN
