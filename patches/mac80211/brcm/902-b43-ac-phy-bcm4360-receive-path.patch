+/* RX baseband setup, run at the end of every channel change. */
+void b43_phy_ac_bcm4360_rx_rev1_prepare(struct b43_wldev *dev)
+{
+	u32 ioctl;
+	u16 base;
+	u8 core_count;
+	unsigned int core;
+
+	b43_phy_set(dev, 0x019e, 0x01c0);
+	b43_phy_write(dev, 0x03c4, 0x0668);
+	b43_phy_set(dev, 0x019e, 0x0200);
+	b43_phy_maskset(dev, 0x019e, (u16)~0x003c, 0x0010);
+	b43_phy_write(dev, 0x01f2, 0x00c8);
+	b43_phy_write(dev, 0x0026, 0x0092);
+	b43_phy_write(dev, 0x01ed, 0x0050);
+	b43_phy_write(dev, 0x0025, 0x0030);
+
+	/* D11 core flag 0x10 (core I/O control). */
+	ioctl = bcma_aread32(dev->dev->bdev, BCMA_IOCTL);
+	ioctl |= 0x00000010;
+	bcma_awrite32(dev->dev->bdev, BCMA_IOCTL, ioctl);
+
+	b43_phy_mask(dev, 0x040f, (u16)~0x0200);
+
+	b43_phy_mask(dev, 0x02f1, (u16)~0x0020);
+	b43_phy_mask(dev, 0x02ed, (u16)~0x0020);
+	b43_phy_mask(dev, 0x02f9, (u16)~0x0020);
+	b43_phy_mask(dev, 0x02f5, (u16)~0x0020);
+
+	b43_phy_maskset(dev, 0x02ef, (u16)~0x00ff, 0x0055);
+	b43_phy_maskset(dev, 0x02eb, (u16)~0x00ff, 0x0055);
+	b43_phy_maskset(dev, 0x02f7, (u16)~0x00ff, 0x0055);
+	b43_phy_maskset(dev, 0x02f3, (u16)~0x00ff, 0x0055);
+
+	/* AC-PHY rev 1 does not need the rev 2/5/6 settings. */
+	b43_phy_write(dev, 0x0400, 0x0000);
+	b43_phy_mask(dev, 0x01ca, (u16)~0x1000);
+
+	b43_phy_ac_resetcca_rev1(dev);
+
+	b43_phy_set(dev, 0x0072, 0x0004);
+	b43_phy_mask(dev, 0x01b0, (u16)~0x0020);
+	b43_phy_set(dev, 0x01b1, 0x1000);
+	b43_phy_mask(dev, 0x01b6, (u16)~0x8000);
+
+	core_count = b43_radio_2069_core_count(dev);
+
+	for (core = 0; core < core_count; core++) {
+		base = 0x0690 + core * 0x0200;
+		b43_phy_set(dev, base, 0x0200);
+	}
+
+	for (core = 0; core < core_count; core++) {
+		base = 0x0690 + core * 0x0200;
+		b43_phy_set(dev, base, 0x0400);
+	}
+
+	b43_phy_write(dev, 0x01e6, 0x0030);
+
+	/* RX front-end setup (AC-PHY rev 1). */
+	b43_phy_maskset(dev, 0x02d1, (u16)~0x00f0, 0x0040);
+	b43_phy_maskset(dev, 0x02d1, (u16)~0x0f00, 0x0400);
+
+	b43_phy_write(dev, 0x0358, 0xc07f);
+	b43_phy_write(dev, 0x0359, 0x0064);
+	b43_phy_write(dev, 0x035a, 0x0064);
+
+	b43_phy_ac_bcm4360_femctrl_lut(dev);
+}
 
