+	.software_rfkill	= b43_phy_ac_op_software_rfkill,
+	.switch_channel		= b43_phy_ac_op_switch_channel,
 	.allocate		= b43_phy_ac_op_allocate,
 	.free			= b43_phy_ac_op_free,
+	.prepare_structs	= b43_phy_ac_op_prepare_structs,
 	.phy_maskset		= b43_phy_ac_op_maskset,
 	.radio_read		= b43_phy_ac_op_radio_read,
 	.radio_write		= b43_phy_ac_op_radio_write,
 	.get_default_chan	= b43_phy_ac_op_get_default_chan,
 	.recalc_txpower		= b43_phy_ac_op_recalc_txpower,
 	.adjust_txpower		= b43_phy_ac_op_adjust_txpower,
+	.switch_analog		= b43_phy_ac_op_switch_analog,
 };
+
+/*
+ * Per-core clip gate for AC-PHY revisions other than 0: false sets
+ * PHY[0x6d4 + core * 0x200] bit 0x4000, true clears it.  Revision 0 uses
+ * a different mechanism and is not handled.
+ */
+void b43_phy_ac_carrier_core_gate_nonzero_rev(struct b43_wldev *dev,
+					      bool restore)
+{
+	u8 core_count;
+	u8 core;
+
+	if (!dev->phy.rev)
+		return;
+
+	core_count = b43_radio_2069_core_count(dev);
+
+	for (core = 0; core < core_count; core++) {
+		u16 reg = 0x06d4 + ((u16)core << 9);
+
+		if (restore)
+			b43_phy_mask(dev, reg, ~0x4000);
+		else
+			b43_phy_set(dev, reg, 0x4000);
+	}
+}
+
+/*
+ * Nested stay-in-carrier-search control.
+ *
+ * Enter at depth 0: classifier mask 7 -> 4, OFDM CRS off, per-core clip
+ * gate set, PHY 0x339 = 0.  Every enter: depth++, CCA reset.
+ *
+ * Exit: depth--; at depth 0 restore the classifier (7 on 2.4 GHz, 6 on
+ * 5 GHz), OFDM CRS on, clip gate cleared and PHY 0x339 (0x0fff).  There is
+ * no CCA reset on the final exit.  An unbalanced exit is ignored with a
+ * warning.
+ */
+void b43_phy_ac_bcm4360_stay_in_carrier_search_rev1(struct b43_wldev *dev,
+						    bool enable)
+{
+	struct b43_phy_ac *phy_ac = dev->phy.ac;
+	u16 classifier_restore;
+
+	if (enable) {
+		if (!phy_ac->carrier_search_depth) {
+			b43_phy_ac_classifier(dev, 0x0007, 0x0004);
+			b43_phy_ac_ofdm_crs(dev, false);
+			b43_phy_ac_carrier_core_gate_nonzero_rev(dev, false);
+			b43_phy_write(dev, 0x0339, 0x0000);
+		}
+
+		phy_ac->carrier_search_depth++;
+		b43_phy_ac_resetcca_rev1(dev);
+		return;
+	}
+
+	if (!phy_ac->carrier_search_depth) {
+		b43warn(dev->wl,
+			"BCM4360 AC-PHY unbalanced carrier-search exit\n");
+		return;
+	}
+
+	phy_ac->carrier_search_depth--;
+
+	if (phy_ac->carrier_search_depth)
+		return;
+
+	/* Without a chandef yet (2.4 GHz only device) the classifier value is 7. */
+	if (!dev->wl->hw->conf.chandef.chan)
+		classifier_restore = 0x0007;
+	else
+		classifier_restore =
+			b43_current_band(dev->wl) == NL80211_BAND_2GHZ ?
+			0x0007 : 0x0006;
+
+	b43_phy_ac_classifier(dev, 0x0007, classifier_restore);
+	b43_phy_ac_ofdm_crs(dev, true);
+	b43_phy_ac_carrier_core_gate_nonzero_rev(dev, true);
+	b43_phy_write(dev, 0x0339,
+		      phy_ac->carrier_search_339_restore);
+}
+
+static bool b43_phy_ac_is_bcm4360_rx(struct b43_wldev *dev)
+{
+	return dev->phy.ac && dev->bcm4360_board &&
+	       b43_radio_2069_core_count(dev) == dev->bcm4360_board->cores;
+}
+
+/*
+ * Post-channel state: energy-detect thresholds and the rev 1 tail.  No
+ * idle-TSSI measurement (TX power control) is performed: it transmits a
+ * tone, and this driver is receive-only.
+ */
+bool b43_phy_ac_bcm4360_post_init_rev1(struct b43_wldev *dev)
+{
+	if (!b43_phy_ac_is_bcm4360_rx(dev))
+		return false;
+
+	/* Energy-detect thresholds: baseline values first... */
+	b43_phy_write(dev, 0x033a, 0x03ac);
+	b43_phy_write(dev, 0x033b, 0x03ac);
+	b43_phy_write(dev, 0x033e, 0x03ac);
+	b43_phy_write(dev, 0x033f, 0x03ac);
+	b43_phy_write(dev, 0x0342, 0x03ac);
+	b43_phy_write(dev, 0x0343, 0x03ac);
+	b43_phy_write(dev, 0x0346, 0x03ac);
+	b43_phy_write(dev, 0x0347, 0x03ac);
+
+	b43_phy_write(dev, 0x033c, 0x032c);
+	b43_phy_write(dev, 0x033d, 0x032c);
+	b43_phy_write(dev, 0x0340, 0x032c);
+	b43_phy_write(dev, 0x0341, 0x032c);
+	b43_phy_write(dev, 0x0344, 0x032c);
+	b43_phy_write(dev, 0x0345, 0x032c);
+	b43_phy_write(dev, 0x0348, 0x032c);
+	b43_phy_write(dev, 0x0349, 0x032c);
+
+	/* ...then the -69 dBm default (0x03bf / 0x0340). */
+	b43_phy_write(dev, 0x033a, 0x03bf);
+	b43_phy_write(dev, 0x033b, 0x03bf);
+	b43_phy_write(dev, 0x033e, 0x03bf);
+	b43_phy_write(dev, 0x033f, 0x03bf);
+	b43_phy_write(dev, 0x0342, 0x03bf);
+	b43_phy_write(dev, 0x0343, 0x03bf);
+	b43_phy_write(dev, 0x0346, 0x03bf);
+	b43_phy_write(dev, 0x0347, 0x03bf);
+
+	b43_phy_write(dev, 0x033c, 0x0340);
+	b43_phy_write(dev, 0x033d, 0x0340);
+	b43_phy_write(dev, 0x0340, 0x0340);
+	b43_phy_write(dev, 0x0341, 0x0340);
+	b43_phy_write(dev, 0x0344, 0x0340);
+	b43_phy_write(dev, 0x0345, 0x0340);
+	b43_phy_write(dev, 0x0348, 0x0340);
+	b43_phy_write(dev, 0x0349, 0x0340);
+
+	/* Rev 1 tail. */
+	b43_phy_write(dev, 0x016e, 0x0013);
+	b43_phy_write(dev, 0x016f, 0x07d0);
+	b43_phy_write(dev, 0x0170, 0x07d0);
+
+	return true;
+}
