+	int radio2069_init_error;
+
+	/*
+	 * Stay-in-carrier-search nesting depth and the PHY 0x339 value
+	 * restored when the outermost level exits.
+	 */
+	u32 carrier_search_depth;
+	u16 carrier_search_339_restore;
 };
 
