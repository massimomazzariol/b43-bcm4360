From: Massimo Mazzariol <massimomazzariol@users.noreply.github.com>
Subject: [PATCH] b43: AC-PHY: BCM4360 2.4 GHz receive path

AC-PHY rev 1 initialisation and channel switching for the BCM4360
2.4 GHz device: carrier-search control, BCM2069 channel programming,
RX LPF, receive gains, clip and energy-detect thresholds, board
front-end control table and per-channel RX Farrow/SFO.  Receive only:
no TX power control or calibration that transmits.

Chip/radio tables and board settings are not part of the source; they
come from the data sets described in bcm4360.h.  Kconfig: B43_PHY_AC is
no longer BROKEN but only initialises the BCM4360 receive-only device.
---
--- a/drivers/net/wireless/broadcom/b43/Kconfig
+++ b/drivers/net/wireless/broadcom/b43/Kconfig
@@ -150,13 +150,24 @@ config B43_PHY_LCN
 	  Say N, this is BROKEN and crashes driver.
 
 config B43_PHY_AC
-	bool "Support for AC-PHY (802.11ac) devices (BROKEN)"
-	depends on B43 && B43_BCMA && BROKEN
+	bool "Support for AC-PHY devices (EXPERIMENTAL, receive-only BCM4360)"
+	depends on B43 && B43_BCMA
 	help
+	  Experimental support for Broadcom AC-PHY devices.
+
 	  This PHY type can be found in the following chipsets:
 	  PCI: BCM4352, BCM4360
 
-	  Say N, this is BROKEN and crashes driver.
+	  Only the BCM4360 2.4 GHz device (SPROM device ID 0x43a1, AC-PHY
+	  rev 1, BCM2069 rev 4) on the ASUS RT-AC68U (device tree compatible
+	  "asus,rt-ac68u") is initialized, as a receive-only device: passive
+	  scanning and monitor reception, with transmission disabled.  Every
+	  other AC-PHY device and every other board is rejected.
+
+	  The device also needs two hardware data packages in the firmware
+	  search path (b43/bcm4360-ac1-2069r4.bin and the board package);
+	  they are not part of the kernel sources.  Without them the device
+	  is not initialized.
 
 # This config option automatically enables b43 LEDS support,
 # if it's possible.
--- a/drivers/net/wireless/broadcom/b43/Makefile
+++ b/drivers/net/wireless/broadcom/b43/Makefile
@@ -14,7 +14,8 @@ b43-$(CPTCFG_B43_PHY_HT)	+= phy_ht.o
 b43-$(CPTCFG_B43_PHY_HT)	+= tables_phy_ht.o
 b43-$(CPTCFG_B43_PHY_HT)	+= radio_2059.o
 b43-$(CPTCFG_B43_PHY_LCN)	+= phy_lcn.o tables_phy_lcn.o
-b43-$(CPTCFG_B43_PHY_AC)	+= phy_ac.o
+b43-$(CPTCFG_B43_PHY_AC)	+= phy_ac.o tables_phy_ac.o radio_2069.o
+b43-$(CPTCFG_B43_PHY_AC)	+= bcm4360_board.o bcm4360_data_fw.o
 b43-y				+= sysfs.o
 b43-y				+= xmit.o
 b43-y				+= dma.o
--- /dev/null
+++ b/drivers/net/wireless/broadcom/b43/bcm4360.h
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Broadcom B43 wireless driver
+ * BCM4360 receive-only support: board profiles and hardware data sets
+ *
+ * Copyright (c) 2026 Massimo Mazzariol <massimomazzariol@users.noreply.github.com>
+ */
+#ifndef B43_BCM4360_H_
+#define B43_BCM4360_H_
+
+#include <linux/types.h>
+
+struct b43_wldev;
+struct bcma_device;
+struct device;
+
+/*
+ * BCM4360 receive-only support is split in three layers:
+ *
+ *   AC-PHY code (phy_ac.c, tables_phy_ac.c)       chip and PHY behaviour
+ *   BCM4360 data set (struct b43_bcm4360_data)   chip/radio tables
+ *   board profile (struct b43_bcm4360_board)     one supported board
+ *
+ * The data sets are not part of the driver source.  They are loaded from
+ * two data packages in the firmware search path (bcm4360_data_fw.c): one
+ * for the chip/radio, one for the board.  A device is only brought up
+ * when a board profile matches it and both packages are present and
+ * valid; otherwise it is rejected before any PHY or radio access.
+ */
+
+/* One PHY table write: table id, first offset, entry width (bits), count. */
+struct b43_phy_ac_tbl {
+	u16 id;
+	u16 offset;
+	u16 width;
+	u16 count;
+	const void *data;
+};
+
+/* BCM2069 rev 4 2.4 GHz channel row: 58 words, word 0 is the channel. */
+#define B43_BCM2069_REV4_CHAN_WORDS	58
+
+struct b43_bcm2069_reg_value {
+	u16 reg;
+	u16 value;
+};
+
+/* Per-channel receive Farrow resampler phase increment (24 bits). */
+struct b43_bcm4360_farrow {
+	u16 deltaphase_lo;
+	u16 deltaphase_hi;
+};
+
+/*
+ * Receive gain tables (2.4 GHz): gain, gain-bits and gain-limit entries
+ * of the LNA1, LNA2 and mixer/TIA stages, written to the per-core gain
+ * tables at every channel change.
+ */
+struct b43_bcm4360_rx_gain_tables {
+	u8 lna1_gain[6];
+	u8 lna1_gainbits[6];
+	u8 lna1_gainlimit[6];
+	u8 lna2_gain[7];
+	u8 lna2_gainbits[7];
+	u8 lna2_gainlimit[7];
+	u8 mix_gain[10];
+	u8 mix_gainbits[10];
+};
+
+/* RX EVM shaping entries of PHY table 4 (offsets 0x01 and 0x3d). */
+struct b43_bcm4360_rx_evm {
+	u8 lo[3];
+	u8 hi[3];
+};
+
+/* Chip/radio data set for BCM4360 / AC-PHY rev 1 / BCM2069 rev 4. */
+struct b43_bcm4360_data {
+	/* PHY tables written once before the first channel set. */
+	const struct b43_phy_ac_tbl *init_tables;
+	unsigned int n_init_tables;
+
+	/* RF-sequencer (table 7) entries written after the RX LPF update. */
+	const struct b43_phy_ac_tbl *rfseq7;
+	unsigned int n_rfseq7;
+
+	/* Optional: tables written on every channel set. */
+	const struct b43_phy_ac_tbl *chan_tables;
+	unsigned int n_chan_tables;
+
+	/* BCM2069 rev 4 radio register defaults. */
+	const struct b43_bcm2069_reg_value *prefregs;
+	unsigned int n_prefregs;
+
+	/* Channels 1..14, rows in channel order. */
+	const u16 (*chan_2g)[B43_BCM2069_REV4_CHAN_WORDS];
+	unsigned int n_chan_2g;
+
+	/* Channels 1..14. */
+	const struct b43_bcm4360_farrow *farrow_2g;
+	unsigned int n_farrow_2g;
+
+	/* Receive gain tables. */
+	const struct b43_bcm4360_rx_gain_tables *rx_gain_tables;
+
+	/* Optional: RX EVM shaping entries. */
+	const struct b43_bcm4360_rx_evm *rx_evm;
+};
+
+/* Receive gain configuration that depends on the board front end. */
+struct b43_bcm4360_rx_gain {
+	u8 elna_gain_db;		/* external LNA gain */
+	u8 trloss_db;			/* T/R switch loss */
+	u16 gain_code_a[5];		/* init, high, mid, low, clip2 */
+	u16 gain_code_b[5];
+	u16 rfseq_init_gain;
+};
+
+/* Board-specific data set. */
+struct b43_bcm4360_board_data {
+	/* Front-end control table (PHY table 0x0a), 32 entries per core. */
+	const u8 (*fem_lut)[32];
+	unsigned int n_fem_cores;
+
+	/* Receive gain configuration. */
+	const struct b43_bcm4360_rx_gain *rx_gain;
+};
+
+struct b43_bcm4360_board {
+	const char *name;
+	const char *compatible;		/* device tree machine compatible */
+
+	/* Accepted device: chip, SPROM device id (radio slot), PHY, radio. */
+	u16 chip_id;
+	u16 sprom_dev_id;
+	u8 phy_rev;
+	u16 radio_ver;
+	u8 radio_rev;
+	u8 cores;
+
+	/* NVRAM prefix of this radio slot, used to validate board data. */
+	const char *nvram_prefix;
+	u32 xtal_khz;			/* reference crystal */
+	u8 femctrl;			/* NVRAM femctrl */
+	u8 fem_variant;			/* boardflags3[2:0] */
+	u32 boardflags3_clear;		/* boardflags3 bits that must be clear */
+	u8 rxgains_elna;		/* NVRAM rxgains2gelnagaina0..2 */
+	u8 rxgains_triso;		/* NVRAM rxgains2gtrisoa0..2 */
+
+	/* Board data package: file name and the tag stored in its header. */
+	const char *data_file;
+	const char *data_tag;
+};
+
+/* Chip/radio data package (firmware search path). */
+#define B43_BCM4360_CHIP_DATA_FILE	"b43/bcm4360-ac1-2069r4.bin"
+
+#ifdef CPTCFG_B43_PHY_AC
+const struct b43_bcm4360_board *b43_bcm4360_board_match(struct b43_wldev *dev);
+bool b43_bcm4360_bcma_ready(struct bcma_device *core);
+
+/*
+ * Data provider: load (once) and validate the chip/radio and board data
+ * packages; return 0 and fill both pointers, or a negative error.
+ */
+int b43_bcm4360_data_get(const struct b43_bcm4360_board *board,
+			 struct device *dev,
+			 const struct b43_bcm4360_data **data,
+			 const struct b43_bcm4360_board_data **board_data);
+/* Free the loaded data packages (module exit). */
+void b43_bcm4360_data_release(void);
+
+/* Check that the data sets hold every section the receive path needs. */
+int b43_bcm4360_data_check(const struct b43_bcm4360_board *board,
+			   const struct b43_bcm4360_data *data,
+			   const struct b43_bcm4360_board_data *board_data);
+#else
+static inline bool b43_bcm4360_bcma_ready(struct bcma_device *core)
+{
+	return false;
+}
+
+static inline void b43_bcm4360_data_release(void)
+{
+}
+#endif
+
+#endif /* B43_BCM4360_H_ */
--- a/drivers/net/wireless/broadcom/b43/phy_ac.c
+++ b/drivers/net/wireless/broadcom/b43/phy_ac.c
@@ -4,10 +4,402 @@
  * IEEE 802.11ac AC-PHY support
  *
  * Copyright (c) 2015 Rafał Miłecki <zajec5@gmail.com>
+ * Copyright (c) 2026 Massimo Mazzariol <massimomazzariol@users.noreply.github.com>
  */
 
+#include <linux/delay.h>
+
 #include "b43.h"
+#include "main.h"
 #include "phy_ac.h"
+#include "bcm4360.h"
+#include "tables_phy_ac.h"
+#include "radio_2069.h"
+
+/*
+ * BCM4360 (AC-PHY rev 1, BCM2069 rev 4) 2.4 GHz receive path.
+ *
+ * Chip and radio tables come from dev->bcm4360_data, board front-end
+ * settings from dev->bcm4360_board and dev->bcm4360_board_data (see
+ * bcm4360.h).  Only the AC-PHY rev 1 receive path is implemented.
+ */
+static void b43_phy_ac_resetcca_rev1(struct b43_wldev *dev);
+
+/* RF-sequencer (table 7) entries written after the RX LPF update. */
+static void
+b43_phy_ac_bcm4360_post_rxlpf_table7_rev1(struct b43_wldev *dev)
+{
+	const struct b43_bcm4360_data *data = dev->bcm4360_data;
+	unsigned int i;
+	u16 saved;
+
+	saved = b43_phy_read(dev, 0x019e) & 0x0002;
+	b43_phy_maskset(dev, 0x019e, (u16)~0x0002, 0x0002);
+
+	for (i = 0; i < data->n_rfseq7; i++)
+		b43_phy_ac_table_write_bulk(dev, data->rfseq7[i].id,
+					    data->rfseq7[i].offset,
+					    data->rfseq7[i].width,
+					    data->rfseq7[i].count,
+					    data->rfseq7[i].data);
+
+	b43_phy_maskset(dev, 0x019e, (u16)~0x0002, saved);
+}
+
+/*
+ * Update the two RX LPF fields (bits 6..16 and 17..25) of the selected
+ * RF-sequencer table 7 groups for the selected cores.  Each entry is
+ * split over a low and a high 16-bit table word.
+ */
+bool b43_phy_ac_rx_lpf_update(struct b43_wldev *dev, u8 groups,
+			      u8 rx_mask, u16 field6, u16 field17)
+{
+	static const u16 offsets[3][2][3] = {
+		{ { 0x140, 0x150, 0x160 }, { 0x360, 0x370, 0x380 } },
+		{ { 0x141, 0x151, 0x161 }, { 0x361, 0x371, 0x381 } },
+		{ { 0x441, 0x443, 0x445 }, { 0x440, 0x442, 0x444 } },
+	};
+	u8 cores = b43_radio_2069_core_count(dev);
+	u16 saved;
+	unsigned int core, group;
+
+	if (cores > 3 || (groups & ~7) || (rx_mask & ~7))
+		return false;
+
+	saved = b43_phy_read(dev, 0x019e) & 2;
+	b43_phy_maskset(dev, 0x019e, (u16)~2, 2);
+	for (core = 0; core < cores; core++) {
+		if (!(rx_mask & BIT(core)))
+			continue;
+		for (group = 0; group < 3; group++) {
+			u16 lo, hi;
+			u32 value;
+
+			if (!(groups & BIT(group)))
+				continue;
+			b43_phy_write(dev, B43_PHY_AC_TABLE_ID, 7);
+			b43_phy_write(dev, B43_PHY_AC_TABLE_OFFSET,
+				      offsets[group][0][core]);
+			lo = b43_phy_read(dev, B43_PHY_AC_TABLE_DATA1);
+			b43_phy_write(dev, B43_PHY_AC_TABLE_ID, 7);
+			b43_phy_write(dev, B43_PHY_AC_TABLE_OFFSET,
+				      offsets[group][1][core]);
+			hi = b43_phy_read(dev, B43_PHY_AC_TABLE_DATA1);
+			value = lo | ((u32)hi << 16);
+			/* Two masks, applied in this order. */
+			value = (value & 0x01ffc03f) | ((u32)field6 << 6);
+			value = (value & 0x0001ffff) | ((u32)field17 << 17);
+			lo = value;
+			hi = (value >> 16) & 0x01ff;
+			b43_phy_ac_table_write_bulk(dev, 7,
+						    offsets[group][0][core],
+						    16, 1, &lo);
+			b43_phy_ac_table_write_bulk(dev, 7,
+						    offsets[group][1][core],
+						    16, 1, &hi);
+		}
+	}
+	b43_phy_maskset(dev, 0x019e, (u16)~2, saved);
+
+	/* After the last group: RF-sequencer entries. */
+	if (groups == 0x04 && rx_mask == 0x07)
+		b43_phy_ac_bcm4360_post_rxlpf_table7_rev1(dev);
+
+	return true;
+}
+
+/*
+ * Board front-end control table (PHY table 0x0a), 32 entries per core.
+ * Entries 0-15 drive the T/R switch and external LNA on 2.4 GHz.
+ */
+static void b43_phy_ac_bcm4360_femctrl_lut(struct b43_wldev *dev)
+{
+	const struct b43_bcm4360_board_data *bd = dev->bcm4360_board_data;
+	unsigned int core;
+
+	for (core = 0; core < bd->n_fem_cores; core++)
+		b43_phy_ac_table_write_bulk(dev, 0x000a, core * 32, 8, 32,
+					    bd->fem_lut[core]);
+}
+
+/*
+ * Receive gain state established before the CCA reset and the per-core
+ * calibration: LNA1/LNA2/eLNA/mixer gain tables, init and clip gains,
+ * NB/W1 clip thresholds, CRS and bandwidth seeds (2.4 GHz, no desense).
+ */
+static void
+b43_phy_ac_bcm4360_pre_afecal_rxgain_rev1(struct b43_wldev *dev)
+{
+	/* Gain-code registers per state (init, high, mid, low, clip2). */
+	static const u16 gain_code_reg_a[5][3] = {
+		{ 0x06dc, 0x08dc, 0x0adc },
+		{ 0x06de, 0x08de, 0x0ade },
+		{ 0x06e0, 0x08e0, 0x0ae0 },
+		{ 0x06e2, 0x08e2, 0x0ae2 },
+		{ 0x06e4, 0x08e4, 0x0ae4 },
+	};
+
+	static const u16 gain_code_reg_b[5][3] = {
+		{ 0x06dd, 0x08dd, 0x0add },
+		{ 0x06df, 0x08df, 0x0adf },
+		{ 0x06e1, 0x08e1, 0x0ae1 },
+		{ 0x06e3, 0x08e3, 0x0ae3 },
+		{ 0x06e5, 0x08e5, 0x0ae5 },
+	};
+
+	u16 core;
+	u16 state;
+
+	/*
+	 * NB/W1 clip thresholds without desense:
+	 *   NB: mux 2, NBRSSI reference control high 1
+	 *   W1: mux 2, wideband RSSI1 threshold 15
+	 */
+	static const u16 rssi_clip_mux_reg[3] = {
+		0x06ee, 0x08ee, 0x0aee,
+	};
+
+	static const u16 radio_nbrssi_reg[3] = {
+		0x0045, 0x0245, 0x0445,
+	};
+
+	static const u16 radio_lna2g_rssi_reg[3] = {
+		0x002c, 0x022c, 0x042c,
+	};
+
+	const struct b43_bcm4360_rx_gain_tables *gt =
+		dev->bcm4360_data->rx_gain_tables;
+	const struct b43_bcm4360_rx_gain *rxg =
+		dev->bcm4360_board_data->rx_gain;
+	const u8 elna_gain[2] = { rxg->elna_gain_db, rxg->elna_gain_db };
+	u16 stall_save;
+	u16 fine_rx_clk_save;
+
+	/* RX front-end setup (AC-PHY rev 1). */
+	b43_phy_maskset(dev, 0x02d1, (u16)~0x00f0, 0x0040);
+	b43_phy_maskset(dev, 0x02d1, (u16)~0x0f00, 0x0400);
+
+	b43_phy_write(dev, 0x0358, 0xc07f);
+	b43_phy_write(dev, 0x0359, 0x0064);
+	b43_phy_write(dev, 0x035a, 0x0064);
+
+	b43_phy_ac_bcm4360_femctrl_lut(dev);
+
+	/*
+	 * Hold RxFeCtrl1.disable_stalls and the forced gain-gated clocks
+	 * while the gain tables are written; restore both before the gain
+	 * codes.
+	 */
+	stall_save = b43_phy_read(dev, 0x019e);
+	b43_phy_set(dev, 0x019e, 0x0002);
+
+	fine_rx_clk_save = b43_phy_read(dev, 0x016c);
+	b43_phy_set(dev, 0x016c, 0x0040);
+
+	/* LNA1, cores 0..2. */
+	b43_phy_ac_table_write_bulk(dev, 0x0044, 0x0008, 8, 6, gt->lna1_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0045, 0x0008, 8, 6, gt->lna1_gainbits);
+
+	b43_phy_ac_table_write_bulk(dev, 0x0064, 0x0008, 8, 6, gt->lna1_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0065, 0x0008, 8, 6, gt->lna1_gainbits);
+
+	b43_phy_ac_table_write_bulk(dev, 0x0084, 0x0008, 8, 6, gt->lna1_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0085, 0x0008, 8, 6, gt->lna1_gainbits);
+
+	/* LNA1 gain limits (shared). */
+	b43_phy_ac_table_write_bulk(dev, 0x000b, 0x0008, 8, 6, gt->lna1_gainlimit);
+
+	/* LNA2, cores 0..2. */
+	b43_phy_ac_table_write_bulk(dev, 0x0044, 0x0010, 8, 7, gt->lna2_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0045, 0x0010, 8, 7, gt->lna2_gainbits);
+
+	b43_phy_ac_table_write_bulk(dev, 0x0064, 0x0010, 8, 7, gt->lna2_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0065, 0x0010, 8, 7, gt->lna2_gainbits);
+
+	b43_phy_ac_table_write_bulk(dev, 0x0084, 0x0010, 8, 7, gt->lna2_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0085, 0x0010, 8, 7, gt->lna2_gainbits);
+
+	/* LNA2 gain limits (shared). */
+	b43_phy_ac_table_write_bulk(dev, 0x000b, 0x0010, 8, 7, gt->lna2_gainlimit);
+
+	/* Board external LNA gain: eLNA stage, two entries at offset 0. */
+	b43_phy_ac_table_write_bulk(dev, 0x0044, 0x0000, 8, 2, elna_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0064, 0x0000, 8, 2, elna_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0084, 0x0000, 8, 2, elna_gain);
+
+	/* Board T/R switch loss: freqGainTLossN, bits [14:8] per core. */
+	for (core = 0; core < 3; core++)
+		b43_phy_maskset(dev, 0x06f9 + (core << 9), (u16)~0x7f00,
+				(u16)rxg->trloss_db << 8);
+
+	/* 2.4 GHz: lna2_gm_sz = 2, mix/tia_gm_sz = 1. */
+	b43_phy_write(dev, 0x073b, 0x0018);
+	b43_phy_write(dev, 0x093b, 0x0018);
+	b43_phy_write(dev, 0x0b3b, 0x0018);
+
+	b43_phy_write(dev, 0x0726, 0x000c);
+	b43_phy_write(dev, 0x0926, 0x000c);
+	b43_phy_write(dev, 0x0b26, 0x000c);
+
+	/* Mixer/TIA stage, 10 entries at offset 32. */
+	b43_phy_ac_table_write_bulk(dev, 0x0044, 0x0020, 8, 10, gt->mix_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0045, 0x0020, 8, 10, gt->mix_gainbits);
+
+	b43_phy_ac_table_write_bulk(dev, 0x0064, 0x0020, 8, 10, gt->mix_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0065, 0x0020, 8, 10, gt->mix_gainbits);
+
+	b43_phy_ac_table_write_bulk(dev, 0x0084, 0x0020, 8, 10, gt->mix_gain);
+	b43_phy_ac_table_write_bulk(dev, 0x0085, 0x0020, 8, 10, gt->mix_gainbits);
+
+	/* Restore the stall and clock-gate state saved above. */
+	b43_phy_write(dev, 0x016c, fine_rx_clk_save);
+	b43_phy_maskset(dev, 0x019e, (u16)~0x0002,
+			stall_save & 0x0002);
+
+	/*
+	 * Gain codes per core: init (also the RF-sequencer init gain),
+	 * high, mid, low, clip2.
+	 */
+	for (core = 0; core < 3; core++) {
+		for (state = 0; state < 5; state++) {
+			b43_phy_write(dev, gain_code_reg_a[state][core],
+				      rxg->gain_code_a[state]);
+
+			b43_phy_write(dev, gain_code_reg_b[state][core],
+				      rxg->gain_code_b[state]);
+
+			if (state == 0)
+				b43_phy_ac_table_write_bulk(dev, 0x0007,
+							    0x00f9 + core,
+							    16, 1,
+							    &rxg->rfseq_init_gain);
+		}
+	}
+
+	/* NB/W1 clip thresholds per core. */
+	for (core = 0; core < 3; core++) {
+		/* NB clip mux select: bits 1:0 = 2. */
+		b43_phy_maskset(dev, rssi_clip_mux_reg[core],
+				(u16)~0x0003, 0x0002);
+
+		/* NBRSSI reference control high: bit 6 = 1. */
+		b43_radio_maskset(dev, radio_nbrssi_reg[core],
+				  (u16)~0x0040, 0x0040);
+
+		/* W1 clip mux select: bits 3:2 = 2. */
+		b43_phy_maskset(dev, rssi_clip_mux_reg[core],
+				(u16)~0x000c, 0x0008);
+
+		/* Wideband RSSI1 threshold: bits 7:4 = 15. */
+		b43_radio_maskset(dev, radio_lna2g_rssi_reg[core],
+				  (u16)~0x00f0, 0x00f0);
+	}
+
+	/* CRS minimum power (main and sub-band, l/u): high byte 0x36. */
+	{
+		static const u16 crs_seed_regs[8] = {
+			0x0324, 0x0330,
+			0x0321, 0x032d,
+			0x032a, 0x0336,
+			0x0327, 0x0333,
+		};
+		unsigned int i;
+
+		for (i = 0; i < 8; i++)
+			b43_phy_maskset(dev, crs_seed_regs[i],
+					(u16)~0xff00, 0x3600);
+	}
+
+	/* 20 MHz bandwidth-select words. */
+	{
+		static const u16 bw_sel_regs[4] = {
+			0x0304, 0x0307, 0x030a, 0x030d
+		};
+		unsigned int i;
+
+		for (i = 0; i < 4; i++)
+			b43_phy_write(dev, bw_sel_regs[i], 0x4e51);
+	}
+
+	/*
+	 * No desense: BPHY detector state DigiGainLimit0 (0x0299) = 0x4477,
+	 * PeakEnergyL (0x03c1) = 0x0010.
+	 */
+	if (b43_current_band(dev->wl) == NL80211_BAND_2GHZ) {
+		b43_phy_write(dev, 0x0299, 0x4477);
+		b43_phy_write(dev, 0x03c1, 0x0010);
+	}
+}
