+/*
+ * AC-PHY rev 1 CCA reset: force the PHY clock, pulse BBCFG.RSTCCA
+ * (0x001 bit 0x4000), restore the saved value, release the forced clock
+ * and settle.  On the BCM4360 (D11 rev 42) the PHY header parameter in
+ * MMIO 0x492 is set to 6 around the pulse and back to 2 afterwards.
+ */
+static void b43_phy_ac_resetcca_rev1(struct b43_wldev *dev)
+{
+	u16 bbcfg;
+	bool exact_target;
+
+	exact_target =
+		dev->dev->bus_type == B43_BUS_BCMA &&
+		dev->dev->chip_id == 0x4360 &&
+		dev->dev->core_rev == 42 &&
+		dev->phy.type == B43_PHYTYPE_AC &&
+		dev->phy.rev == 1 &&
+		dev->phy.radio_ver == 0x2069 &&
+		dev->phy.radio_rev == 4;
+
+	b43_phy_force_clock(dev, true);
+
+	if (exact_target)
+		b43_write16(dev, 0x0492, 0x0006);
+
+	bbcfg = b43_phy_read(dev, 0x0001);
+	b43_phy_write(dev, 0x0001, bbcfg | 0x4000);
+	udelay(1);
+	b43_phy_write(dev, 0x0001, bbcfg & (u16)~0x4000);
+
+	if (exact_target)
+		b43_write16(dev, 0x0492, 0x0002);
+
+	b43_phy_force_clock(dev, false);
+	udelay(2);
+}
+
+/*
+ * One-time AC-PHY rev 1 state before the first channel set: clear the
+ * sleep-ready mailbox (shared memory 0x0184), AFE power-up of the 0x17xx
+ * register bank and the data set's initialisation tables.
+ */
+void b43_phy_ac_bcm4360_base_init_rev1(struct b43_wldev *dev)
+{
+	struct b43_phy_ac *ac = dev->phy.ac;
+	u16 afe_cfg2;
+	u16 afe_override;
+
+	if (!ac)
+		return;
+
+	if (ac->bcm4360_rev1_base_init_done)
+		return;
+
+	/* Clear the sleep-ready mailbox before the first channel set. */
+	b43_shm_write16(dev, B43_SHM_SHARED, 0x0184, 0x0000);
+
+	b43_phy_set(dev, 0x01b0, 0x8000);
+
+	/* 0x0410 = 0x0077 only while the 0x17xx bank is cleared. */
+	b43_phy_write(dev, 0x0410, 0x0077);
+
+	b43_phy_write(dev, 0x173e, 0x0000);
+	b43_phy_write(dev, 0x1725, 0x0000);
+	b43_phy_write(dev, 0x1722, 0x0000);
+	b43_phy_write(dev, 0x1723, 0x0000);
+	b43_phy_write(dev, 0x1724, 0x0000);
+	b43_phy_write(dev, 0x1725, 0x0000);
+	b43_phy_write(dev, 0x1726, 0x0000);
+	b43_phy_write(dev, 0x1727, 0x0000);
+	b43_phy_write(dev, 0x1750, 0x0000);
+
+	b43_phy_write(dev, 0xffff, 0x0000);
+	b43_phy_write(dev, 0x0410, 0x0000);
+
+	/* AFE powered up. */
+	b43_phy_write(dev, 0x1728, 0x0080);
+	b43_phy_write(dev, 0x1720, 0x0180);
+	b43_phy_write(dev, 0x1729, 0x0000);
+	b43_phy_write(dev, 0x1721, 0x5000);
+
+	/*
+	 * Copy core 0 AFE configuration into the 0x17xx bank:
+	 *   0x173a = 0x073a | 0x0100
+	 *   0x1725 = 0x0725 | 0x0400
+	 */
+	afe_cfg2 = b43_phy_read(dev, 0x073a);
+	b43_phy_write(dev, 0x173a, afe_cfg2 | 0x0100);
+
+	afe_override = b43_phy_read(dev, 0x0725);
+	b43_phy_write(dev, 0x1725, afe_override | 0x0400);
+
+	b43_phy_ac_tables_init(dev);
+
+	b43_phy_write(dev, 0x1645, 0x025c);
+
+	ac->bcm4360_rev1_base_init_done = true;
+}
+
+/*
+ * Receive-related register settings for 2.4 GHz, 20 MHz: NB clip count,
+ * IQ ADC clamp, 20 MHz primary channel and static ACI thresholds.
+ */
+static void b43_phy_ac_bcm4360_f4_rx_target_rev1(struct b43_wldev *dev)
+{
+	static const u16 fastagc_clipcnt[3] = {
+		0x06ef, 0x08ef, 0x0aef
+	};
+	static const u16 afe_override[3] = {
+		0x0725, 0x0925, 0x0b25
+	};
+	static const u16 afe_core_cfg2[3] = {
+		0x073a, 0x093a, 0x0b3a
+	};
+	unsigned int core;
+
+	/* 20 MHz: NB clip count threshold 15 on all three cores. */
+	for (core = 0; core < 3; core++)
+		b43_phy_maskset(dev, fastagc_clipcnt[core],
+				(u16)~0x00ff, 0x000f);
+
+	/*
+	 * Below 80 MHz: IQ ADC clamp enabled in the RF-control override
+	 * and core AFE configuration.
+	 */
+	for (core = 0; core < 3; core++) {
+		b43_phy_maskset(dev, afe_override[core],
+				(u16)~0x0200, 0x0200);
+		b43_phy_maskset(dev, afe_core_cfg2[core],
+				(u16)~0x0080, 0x0080);
+	}
+
+	/* 20 MHz primary-channel selection. */
+	b43_phy_maskset(dev, 0x0164,
+			(u16)~0x0010, 0x0000);
+	b43_phy_maskset(dev, 0x030f,
+			(u16)~0xc000, 0x0000);
+
+	/* Static ACI thresholds, 2.4 GHz. */
+	b43_phy_write(dev, 0x031c, 0x00ff);
+	b43_phy_write(dev, 0x031d, 0x00ff);
+	b43_phy_write(dev, 0x031e, 0x00ff);
+	b43_phy_write(dev, 0x031f, 0x00ff);
+}
+
+/*
+ * Write three 8-bit entries of AC-PHY table 4 with RxFeCtrl1.disable_stalls
+ * (0x019e bit 1) held for the duration of the transaction.
+ */
+static void
+b43_phy_ac_bcm4360_table4_write8(struct b43_wldev *dev,
+				 u16 offset,
+				 const u8 data[3])
+{
+	u16 stall_save;
+
+	stall_save = b43_phy_read(dev, 0x019e);
+
+	b43_phy_set(dev, 0x019e, 0x0002);
+
+	b43_phy_ac_table_write_bulk(dev, 0x0004, offset, 8, 3, data);
+
+	b43_phy_maskset(dev, 0x019e, (u16)~0x0002, stall_save & 0x0002);
+}
+
+/* RX EVM shaping entries of table 4 (2.4 GHz, 20 MHz), when supplied. */
+static void
+b43_phy_ac_bcm4360_rxevm8_rev1(struct b43_wldev *dev)
+{
+	const struct b43_bcm4360_rx_evm *evm = dev->bcm4360_data->rx_evm;
+
+	if (!evm || !dev->phy.ac ||
+	    !dev->wl->hw->conf.chandef.chan ||
+	    b43_current_band(dev->wl) != NL80211_BAND_2GHZ ||
+	    (dev->wl->hw->conf.chandef.width != NL80211_CHAN_WIDTH_20 &&
+	     dev->wl->hw->conf.chandef.width != NL80211_CHAN_WIDTH_20_NOHT))
+		return;
+
+	b43_phy_ac_bcm4360_table4_write8(dev, 0x0001, evm->lo);
+	b43_phy_ac_bcm4360_table4_write8(dev, 0x003d, evm->hi);
+}
+
+/*
+ * Receive Farrow resampler and SFO (PHY_BW1a..BW6) programming, 2.4 GHz,
+ * 20 MHz.  The phase increment comes from the data set's Farrow rows; the
+ * six SFO words are words 52..57 of the channel's BCM2069 channel row.
+ * Drift period 0x1400 and control 0x00a7 are the same on all channels; the
+ * loopback resampler uses the same values.
+ */
+static void
+b43_phy_ac_bcm4360_rx_farrow_sfo_rev1(struct b43_wldev *dev,
+				      unsigned int channel)
+{
+	const struct b43_bcm4360_data *data = dev->bcm4360_data;
+	const u16 *sfo;
+	u16 lo, hi;
+	unsigned int i;
+
+	if (!dev->phy.ac ||
+	    !dev->wl->hw->conf.chandef.chan ||
+	    b43_current_band(dev->wl) != NL80211_BAND_2GHZ ||
+	    channel < 1 || channel > 14 ||
+	    (dev->wl->hw->conf.chandef.width != NL80211_CHAN_WIDTH_20 &&
+	     dev->wl->hw->conf.chandef.width != NL80211_CHAN_WIDTH_20_NOHT))
+		return;
+
+	lo = data->farrow_2g[channel - 1].deltaphase_lo;
+	hi = data->farrow_2g[channel - 1].deltaphase_hi;
+	sfo = &data->chan_2g[channel - 1][52];
+
+	b43_phy_write(dev, 0x019a, lo);
+	b43_phy_write(dev, 0x019b, hi);
+	b43_phy_write(dev, 0x019c, 0x1400);
+	b43_phy_write(dev, 0x0199, 0x00a7);
+
+	b43_phy_write(dev, 0x01a1, lo);
+	b43_phy_write(dev, 0x01a2, hi);
+	b43_phy_write(dev, 0x01a3, 0x1400);
+	b43_phy_write(dev, 0x01a0, 0x00a7);
+
+	for (i = 0; i < 6; i++)
+		b43_phy_write(dev, 0x0371 + i, sfo[i]);
+}
+
+/*
+ * Channel change (2.4 GHz, 20 MHz only).
+ *
+ * The whole transaction runs with the PHY held in carrier search and the
+ * RX FIFO held: data-set channel tables, LOGEN reset, BCM2069 channel row,
+ * RFPLL setup and VCO calibration; then, with RX stalls disabled, the
+ * per-core W2NB/HWACI bits and table 12 state; RX LPF, RX EVM, receive
+ * settings, Farrow/SFO, receive gains, CCA reset and per-core radio
+ * calibration; finally the RX baseband setup.  The post-init block runs
+ * after carrier search is released.
+ *
+ * Before mac80211 has configured a channel (early attach) only the
+ * BCM4360 target is accepted and the gain/calibration steps are skipped.
+ */
+static int b43_phy_ac_op_switch_channel(struct b43_wldev *dev,
+					unsigned int new_channel)
+{
+	bool carrier_owned_here;
+	bool normal_rx_init = false;
+	bool rxfe_hold_active = false;
+	u16 rxfe_saved_stall = 0;
+	u16 rxfe_saved_fifo = 0;
+
+	u8 lpf_a;
+	u8 lpf_b;
+	u16 lpf_g0;
+	u16 lpf_g12;
+	int err;
+
+	if (dev->wl->hw->conf.chandef.chan) {
+		if (b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+			return -EOPNOTSUPP;
+	} else if (dev->dev->chip_id != 0x4360 ||
+		   dev->phy.rev != 1 ||
+		   dev->phy.radio_ver != 0x2069 ||
+		   dev->phy.radio_rev != 4) {
+		return -EOPNOTSUPP;
+	}
+
+	if (new_channel < 1 || new_channel > 14)
+		return -EINVAL;
+
+	if (dev->phy.rev != 1 ||
+	    dev->phy.radio_ver != 0x2069 ||
+	    dev->phy.radio_rev != 4)
+		return -EOPNOTSUPP;
+
+	b43_phy_ac_bcm4360_base_init_rev1(dev);
+
+	/* Data-set tables written on every channel set, before the radio. */
+	{
+		const struct b43_bcm4360_data *data = dev->bcm4360_data;
+		unsigned int i;
+
+		for (i = 0; i < data->n_chan_tables; i++)
+			b43_phy_ac_table_write_bulk(dev,
+						    data->chan_tables[i].id,
+						    data->chan_tables[i].offset,
+						    data->chan_tables[i].width,
+						    data->chan_tables[i].count,
+						    data->chan_tables[i].data);
+	}
+
+	/*
+	 * Hold the RX FIFO (0x019e bit 0) across the radio channel
+	 * programming.  The RX core mask is not changed; on this device all
+	 * three cores stay enabled (PHY 0x401 = 0x7777).
+	 */
+	{
+		u16 rxfe_before;
+
+		rxfe_before = b43_phy_read(dev, 0x019e);
+		rxfe_saved_stall = rxfe_before & 0x0002;
+		rxfe_saved_fifo = rxfe_before & 0x0001;
+
+		b43_phy_maskset(dev, 0x019e,
+				(u16)~0x0001, 0x0001);
+
+		rxfe_hold_active = true;
+	}
+
+	/*
+	 * PHY 0x0003 bit 8 is deliberately not set here: with it, no frame
+	 * is received on this device.
+	 */
+
+	/* Carrier search for the whole channel transaction (not nested). */
+	carrier_owned_here = !dev->phy.ac->carrier_search_depth;
+	if (carrier_owned_here)
+		b43_phy_ac_bcm4360_stay_in_carrier_search_rev1(dev, true);
+
+	/*
+	 * LOGEN reset (RfctrlCoreTxPus0 0x0728 bit 8) around the channel
+	 * row; bit 7 is LOGEN power-up.
+	 */
+	{
+		u16 logen_before;
+		u16 logen_asserted;
+
+		logen_before = b43_phy_read(dev, 0x0728);
+		b43_phy_write(dev, 0x0728,
+			      logen_before | 0x0100);
+		udelay(1);
+
+		logen_asserted = b43_phy_read(dev, 0x0728);
+		b43_phy_write(dev, 0x0728,
+			      logen_asserted & 0xfeff);
+	}
+
+	err = b43_radio_2069_tune_rev4_2g(dev, new_channel);
+	if (err)
+		goto out_carrier;
+
+	b43_radio_2069_rfpll_setup_rev4_2g20(dev);
+	b43_radio_2069_vcocal_rev4(dev);
+
+	b43_phy_maskset(dev, 0x019e,
+			(u16)~0x0001, rxfe_saved_fifo);
+
+	rxfe_hold_active = false;
+
+	/*
+	 * Disable RX stalls (0x019e bit 1) for the channel-state block below;
+	 * the incoming value, saved above, is restored after it.
+	 */
+	b43_phy_maskset(dev, 0x019e,
+			(u16)~0x0002, 0x0002);
+
+	/* RfctrlCoreRxPus bit 12 per core (0x0729 + (core << 9)). */
+	{
+		u8 core_count = b43_radio_2069_core_count(dev);
+		unsigned int core;
+
+		if (core_count > 3) {
+			b43warn(dev->wl,
+				"BCM4360: unexpected BCM2069 core count %u\n",
+				core_count);
+		} else {
+			for (core = 0; core < core_count; core++) {
+				u16 base = (u16)core << 9;
+				u16 reg = 0x0729 + base;
+
+				b43_phy_maskset(dev, reg,
+						(u16)~0x1000, 0x1000);
+			}
+		}
+	}
+
+	/* WRSSI3 bit 11 per core (0x0728 + (core << 9)). */
+	{
+		u8 core_count = b43_radio_2069_core_count(dev);
+		unsigned int core;
+
+		if (core_count > 3) {
+			b43warn(dev->wl,
+				"BCM4360: unexpected BCM2069 core count %u\n",
+				core_count);
+		} else {
+			for (core = 0; core < core_count; core++) {
+				u16 base = (u16)core << 9;
+				u16 reg = 0x0728 + base;
+
+				b43_phy_maskset(dev, reg,
+						(u16)~0x0800, 0x0800);
+			}
+		}
+	}
+
+	/*
+	 * Table 12: clear entries 0x60..0x62 of core 0, 0x64..0x66 of
+	 * core 1 and 0x68..0x6a of core 2.
+	 */
+	{
+		static const u16 zero_pair[2] = {
+			0x0000, 0x0000
+		};
+		static const u16 zero_single;
+		u8 core_count = b43_radio_2069_core_count(dev);
+		unsigned int core;
+
+		if (core_count != 3) {
+			b43warn(dev->wl,
+				"BCM4360: unexpected BCM2069 core count %u\n",
+				core_count);
+		} else {
+			for (core = 0; core < core_count; core++) {
+				u16 offset = 0x0060 + (core * 4);
+
+				b43_phy_ac_table_write_bulk(dev, 12, offset,
+							    16, 2, zero_pair);
+
+				b43_phy_ac_table_write_bulk(dev, 12, offset + 2,
+							    16, 1, &zero_single);
+			}
+		}
+	}
+
+	/* Radio registers 0x002..0x005 of every core cleared next. */
+	{
+		u8 core_count = b43_radio_2069_core_count(dev);
+		unsigned int core;
+
+		if (core_count != 3) {
+			b43warn(dev->wl,
+				"BCM4360: unexpected BCM2069 core count %u\n",
+				core_count);
+		} else {
+			for (core = 0; core < core_count; core++) {
+				u16 bank = (u16)core << 9;
+
+				b43_radio_write(dev, bank | 0x0002, 0x0000);
+				b43_radio_write(dev, bank | 0x0003, 0x0000);
+				b43_radio_write(dev, bank | 0x0004, 0x0000);
+				b43_radio_write(dev, bank | 0x0005, 0x0000);
+			}
+		}
+	}
+
+	/* PHY registers 0x6a0/0x6a1 of every core cleared next. */
+	{
+		u8 core_count = b43_radio_2069_core_count(dev);
+		unsigned int core;
+
+		if (core_count != 3) {
+			b43warn(dev->wl,
+				"BCM4360: unexpected BCM2069 core count %u\n",
+				core_count);
+		} else {
+			for (core = 0; core < core_count; core++) {
+				u16 bank = (u16)core << 9;
+
+				b43_phy_write(dev, 0x06a0 + bank, 0x0000);
+				b43_phy_write(dev, 0x06a1 + bank, 0x0000);
+			}
+		}
+	}
+
+	/* End of the RX-stall hold. */
+	b43_phy_maskset(dev, 0x019e,
+			(u16)~0x0002,
+			rxfe_saved_stall);
+
+	/*
+	 * RX LPF groups 1, 2 and 4 from the analog calibration results;
+	 * the RX core mask stays unchanged (all three cores).
+	 */
+	if (dev->wl->hw->conf.chandef.chan) {
+		lpf_a = dev->phy.ac->radio2069_cal_lpf_a;
+		lpf_b = dev->phy.ac->radio2069_cal_lpf_b;
+
+		lpf_g0 = ((u16)221 * lpf_a) >> 8;
+		lpf_g12 = ((u16)215 * lpf_a) >> 8;
+
+		if (!b43_phy_ac_rx_lpf_update(dev, 0x01, 0x07,
+					      lpf_g0, lpf_b) ||
+		    !b43_phy_ac_rx_lpf_update(dev, 0x02, 0x07,
+					      lpf_g12, lpf_b) ||
+		    !b43_phy_ac_rx_lpf_update(dev, 0x04, 0x07,
+					      lpf_g12, lpf_b)) {
+			b43err(dev->wl,
+			       "BCM4360: RX LPF update failed\n");
+			err = -EIO;
+			goto out_carrier;
+		}
+	}
+
+	b43_phy_ac_bcm4360_rxevm8_rev1(dev);
+
+	b43_phy_ac_bcm4360_f4_rx_target_rev1(dev);
+
+	/* Per-channel RX Farrow / SFO coefficients. */
+	b43_phy_ac_bcm4360_rx_farrow_sfo_rev1(dev, new_channel);
+
+	/* Receive gains, CCA reset, then per-core radio calibration. */
+	if (dev->wl->hw->conf.chandef.chan) {
+		b43_phy_ac_bcm4360_pre_afecal_rxgain_rev1(dev);
+		b43_phy_ac_resetcca_rev1(dev);
+		udelay(1);
+
+		err = b43_radio_2069_calibrate_per_core_rev4(dev);
+		if (err) {
+			b43err(dev->wl,
+			       "BCM2069 rev4 channel %u per-core calibration failed: %d\n",
+			       new_channel, err);
+			goto out_carrier;
+		}
+	}
+
+	/* RX baseband setup, still inside the carrier-search window. */
+	if (dev->wl->hw->conf.chandef.chan) {
+		b43_phy_ac_bcm4360_rx_rev1_prepare(dev);
+
+		normal_rx_init = true;
+	}
+
+	err = 0;
+
+out_carrier:
+	/* Error path: release the RX front-end hold. */
+	if (rxfe_hold_active) {
+		b43_phy_maskset(dev, 0x019e,
+				(u16)~0x0001, rxfe_saved_fifo);
+
+		rxfe_hold_active = false;
+	}
+	if (carrier_owned_here)
+		b43_phy_ac_bcm4360_stay_in_carrier_search_rev1(dev, false);
+
+	/* Post-init block: must run after the RX baseband setup. */
+	if (!err && normal_rx_init) {
+		if (!b43_phy_ac_bcm4360_post_init_rev1(dev)) {
+			b43err(dev->wl,
+			       "BCM4360: post-init failed\n");
+			err = -EIO;
+		}
+	}
+
+	return err;
+}
