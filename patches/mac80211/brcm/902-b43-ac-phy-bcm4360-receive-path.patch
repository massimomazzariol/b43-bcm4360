+static void b43_phy_ac_op_switch_analog(struct b43_wldev *dev, bool on)
+{
+	b43_phyop_switch_analog_generic(dev, on);
+}
+
+/*
+ * AC-PHY classifier control: replace only the requested bits, and write
+ * back even when mask is zero.
+ */
+u16 b43_phy_ac_classifier(struct b43_wldev *dev, u16 mask, u16 value)
+{
+	u16 ctl;
+
+	ctl = b43_phy_read(dev, B43_PHY_AC_CLASSCTL);
+
+	ctl = (ctl & ~mask) | (value & mask);
+	b43_phy_write(dev, B43_PHY_AC_CLASSCTL, ctl);
+
+	return ctl;
+}
+
+/*
+ * Enable or disable OFDM carrier sensing: bit 0x0010 of PHY registers
+ * 0x2ed, 0x2f1, 0x2f5 and 0x2f9.
+ */
+void b43_phy_ac_ofdm_crs(struct b43_wldev *dev, bool enable)
+{
+	u16 value = enable ? 0x0010 : 0x0000;
+
+	b43_phy_maskset(dev, 0x02ed, (u16)~0x0010, value);
+	b43_phy_maskset(dev, 0x02f1, (u16)~0x0010, value);
+	b43_phy_maskset(dev, 0x02f5, (u16)~0x0010, value);
+	b43_phy_maskset(dev, 0x02f9, (u16)~0x0010, value);
+}
