+/*
+ * AC-PHY radio power control.
+ *
+ * b43's software_rfkill callback is void.  Store any power-up failure in
+ * radio2069_init_error; b43_phy_ac_op_init() propagates it through the normal
+ * b43 PHY-init error path.
+ *
+ * The blocked path only gates the two PLL power bits.
+ */
+static void b43_phy_ac_op_software_rfkill(struct b43_wldev *dev, bool blocked)
+{
+	struct b43_phy_ac *ac = dev->phy.ac;
+	u16 chip = dev->dev->chip_id;
+	u16 pu_reg;
+	int err = 0;
+
+	if (b43_read32(dev, B43_MMIO_MACCTL) & B43_MACCTL_ENABLED)
+		b43err(dev->wl,
+		       "AC-PHY software rfkill called while MAC is enabled\n");
+
+	if (chip == 0x4352 || chip == 0x4360 ||
+	    chip == 0xa9c4 || chip == 0xaa06)
+		pu_reg = 0x080b;
+	else
+		pu_reg = 0x080c;
+
+	if (blocked) {
+		/* Radio off: gate both PLL power bits. */
+		b43_radio_mask(dev, pu_reg, (u16)~0x6000);
+		ac->radio2069_init_error = 0;
+		return;
+	}
+
+	if (dev->phy.radio_ver != 0x2069) {
+		err = -ENODEV;
+		b43err(dev->wl,
+		       "AC-PHY unsupported radio 0x%04x\n",
+		       dev->phy.radio_ver);
+		goto fail;
+	}
+
+	/* Only BCM2069 rev 4 is supported. */
+	if (dev->phy.radio_rev != 4) {
+		err = -EOPNOTSUPP;
+		b43err(dev->wl,
+		       "BCM2069 unsupported rev: rev=%u\n",
+		       dev->phy.radio_rev);
+		goto fail;
+	}
+
+	err = b43_radio_2069_power_up_rev4_class0(dev);
+	if (err) {
+		b43err(dev->wl,
+		       "BCM2069 rev4 power-up failed: %d\n",
+		       err);
+		goto fail;
+	}
+
+	ac->radio2069_init_error = 0;
+
+	return;
+
+fail:
+	/* Do not leave the RF PLL powered after a failed power-up. */
+	b43_radio_mask(dev, pu_reg, (u16)~0x6000);
+	ac->radio2069_init_error = err;
+}
+
+/*
+ * Error bridge for the void software_rfkill callback.
+ *
+ * b43_phy_init() invokes software_rfkill(false) immediately before ->init().
+ * Returning the preserved error here enters b43's normal err_block_rf path.
+ */
+static int b43_phy_ac_op_init(struct b43_wldev *dev)
+{
+	int err = dev->phy.ac->radio2069_init_error;
+
+	if (err)
+		return err;
+
+	return 0;
+}
