+/*
+ * BCM4360 baseband PLL frequency.
+ *
+ * The BCM4360 (chip revision > 2) baseband VCO must run at 960.0098 MHz
+ * (40 MHz crystal):
+ *   PLLCTL2 = (24 << 7) | (3 << 4) | 1          = 0x0c31
+ *   PLLCTL3 = 98 * 2^24 / (40 * 10000)          = 0x100e
+ * followed by a PMU PLL update.
+ *
+ * Upstream bcma has no BCM4360 case, so the ROM value PLLCTL3 = 0x00133333
+ * stays active: a 963.00 MHz instead of 960.0098 MHz baseband VCO (+0.31 %),
+ * which shows up as a matching DSSS symbol-clock drift and bad FCS on every
+ * received frame.  The proper owner is bcma_pmu_pll_init(); it is done here
+ * because bcma is built into the target kernel.  Runs before any D11 core
+ * reset and is skipped when the PLL is already programmed.
+ */
+static void b43_bcma_bcm4360_bbpll_init(struct bcma_device *core)
+{
+	struct bcma_bus *bus = core->bus;
+	struct bcma_drv_cc *cc = &bus->drv_cc;
+	u32 pll2, pll3;
+
+	if (bus->chipinfo.id != BCMA_CHIP_ID_BCM4360 ||
+	    !b43_bcm4360_bcma_ready(core) ||
+	    bus->chipinfo.rev <= 2 ||
+	    !(cc->capabilities & BCMA_CC_CAP_PMU))
+		return;
+
+	pll2 = bcma_chipco_pll_read(cc, BCMA_CC_PMU_PLL_CTL2);
+	pll3 = bcma_chipco_pll_read(cc, BCMA_CC_PMU_PLL_CTL3);
+	if (pll2 == 0x0c31 && pll3 == 0x100e)
+		return;
+
+	bcma_chipco_pll_write(cc, BCMA_CC_PMU_PLL_CTL2, 0x0c31);
+	bcma_chipco_pll_write(cc, BCMA_CC_PMU_PLL_CTL3, 0x100e);
+	bcma_pmu_set32(cc, BCMA_CC_PMU_CTL, BCMA_CC_PMU_CTL_PLL_UPD);
+	udelay(100);
+}
